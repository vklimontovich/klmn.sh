resources:
  - apiVersion: v1
    kind: ConfigMap
    metadata:
      name: postgresql-config
    data:
      postgresql.conf: |
        listen_addresses = '*'
        port = 5432
        max_connections = 200
        max_wal_size = 400MB
        wal_keep_size = 128MB
        client_min_messages = error

        ssl = on
        ssl_cert_file = '/etc/postgresql/tls/tls.crt'
        ssl_key_file = '/etc/postgresql/tls/tls.key'
        ssl_prefer_server_ciphers = on
      # Network clients must use TLS
      pg_hba.conf: |
        local all all md5
        host all all 127.0.0.1/32 md5
        host all all ::1/128 md5
        hostssl all all 0.0.0.0/0 md5
        hostssl all all ::/0 md5

  - apiVersion: apps/v1
    kind: StatefulSet
    metadata:
      name: postgresql
      labels: &labels
        app.kubernetes.io/name: postgresql
        app.kubernetes.io/instance: postgresql
        app.kubernetes.io/component: primary
      # Restart when cert-manager renews the TLS cert or config changes
      annotations:
        secret.reloader.stakater.com/reload: "pg-klmn-sh-tls"
        configmap.reloader.stakater.com/reload: "postgresql-config"
    spec:
      replicas: 1
      serviceName: postgresql-hl
      selector:
        matchLabels: *labels
      template:
        metadata:
          labels: *labels
        spec:
          # Explicit: overrides the deprecated serviceAccount field left by the old chart
          serviceAccountName: default
          automountServiceAccountToken: false
          terminationGracePeriodSeconds: 60
          # Data files are owned by uid 1001
          securityContext:
            runAsUser: 1001
            runAsGroup: 1001
            runAsNonRoot: true
            fsGroup: 1001
            fsGroupChangePolicy: OnRootMismatch
            seccompProfile:
              type: RuntimeDefault
          containers:
            - name: postgresql
              # Keep Debian 12: glibc 2.36 matches the collation of existing indexes
              image: postgres:18.6-bookworm@sha256:bbf83594798e144bff365a9c191c5d779f181fb3135902064ab8ff11918020fc
              command:
                - postgres
                - -c
                - config_file=/etc/postgresql/conf/postgresql.conf
                - -c
                - hba_file=/etc/postgresql/conf/pg_hba.conf
              env:
                - name: PGDATA
                  value: /var/lib/postgresql/data
              ports:
                - name: tcp-postgresql
                  containerPort: 5432
              readinessProbe:
                exec:
                  command: ["pg_isready", "-h", "127.0.0.1", "-U", "postgres"]
                periodSeconds: 10
              livenessProbe:
                exec:
                  command: ["pg_isready", "-h", "127.0.0.1", "-U", "postgres"]
                initialDelaySeconds: 30
                periodSeconds: 10
                failureThreshold: 6
              # SIGTERM waits for all clients to disconnect; use fast shutdown
              lifecycle:
                preStop:
                  exec:
                    command: ["pg_ctl", "stop", "-m", "fast", "-w", "-t", "50"]
              resources:
                requests:
                  memory: 1Gi
                  cpu: 500m
                limits:
                  memory: 8Gi
                  cpu: 4
              securityContext:
                allowPrivilegeEscalation: false
                readOnlyRootFilesystem: true
                capabilities:
                  drop: ["ALL"]
              volumeMounts:
                - name: data
                  mountPath: /var/lib/postgresql
                - name: config
                  mountPath: /etc/postgresql/conf
                - name: tls
                  mountPath: /etc/postgresql/tls
                - name: run
                  mountPath: /var/run/postgresql
                - name: tmp
                  mountPath: /tmp
                - name: dshm
                  mountPath: /dev/shm
          volumes:
            - name: config
              configMap:
                name: postgresql-config
            # Postgres accepts a root-owned key with mode 0640
            - name: tls
              secret:
                secretName: pg-klmn-sh-tls
                defaultMode: 0640
            - name: run
              emptyDir: {}
            - name: tmp
              emptyDir: {}
            - name: dshm
              emptyDir:
                medium: Memory
      # Must match the existing StatefulSet; this field is immutable
      volumeClaimTemplates:
        - apiVersion: v1
          kind: PersistentVolumeClaim
          metadata:
            name: data
          spec:
            accessModes:
              - "ReadWriteOnce"
            resources:
              requests:
                storage: "10Gi"
            storageClassName: local-path

  - apiVersion: v1
    kind: Service
    metadata:
      name: postgresql
      annotations:
        internet-gateway/host: "pg.klmn.sh"
        internet-gateway/auto-dns: "true"
        internet-gateway/auto-cert: "true"
        internet-gateway/protocol: "tcp"
        internet-gateway/ip-mode: "node-port"
    spec:
      type: NodePort
      selector: *labels
      ports:
        - name: tcp-postgresql
          port: 5432
          targetPort: tcp-postgresql
          nodePort: 30432

  - apiVersion: v1
    kind: Service
    metadata:
      name: postgresql-hl
    spec:
      clusterIP: None
      publishNotReadyAddresses: true
      selector: *labels
      ports:
        - name: tcp-postgresql
          port: 5432
          targetPort: tcp-postgresql
