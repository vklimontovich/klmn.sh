# Exposes cluster Services on the tailnet. A Service with the annotation
# tailscale.com/expose: "true" gets a proxy pod that joins the tailnet as its own device.
repositories:
  - name: tailscale
    url: https://pkgs.tailscale.com/helmcharts
  - name: bedag
    url: https://bedag.github.io/helm-charts

releases:
  - name: tailscale-operator
    namespace: tailscale
    createNamespace: true
    chart: tailscale/tailscale-operator
    version: "1.104.2"
    values:
      - oauth:
          clientId: {{ requiredEnv "TS_OAUTH_CLIENT_ID" | quote }}
          clientSecret: {{ requiredEnv "TS_OAUTH_CLIENT_SECRET" | quote }}
        operatorConfig:
          hostname: klmn-k8s-operator
          nodeSelector:
            node-role: app-server

  # Use with the annotation tailscale.com/proxy-class: app-server
  - name: tailscale-proxy-classes
    namespace: tailscale
    chart: bedag/raw
    version: "2.0.0"
    needs:
      - tailscale/tailscale-operator
    values:
      - resources:
          - apiVersion: tailscale.com/v1alpha1
            kind: ProxyClass
            metadata:
              name: app-server
            spec:
              statefulSet:
                pod:
                  nodeSelector:
                    node-role: app-server
